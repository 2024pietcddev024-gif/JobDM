# JobDM — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string (URI format).
# Find it at: Supabase Dashboard → Settings → Database → Connection string → URI
# Example: postgresql://postgres.xxxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Authentication ────────────────────────────────────────────────────────────
# A long random string used to sign JWT tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_long_random_jwt_secret_here

# ─── AI (Google Gemini) ────────────────────────────────────────────────────────
# Get your API key at https://aistudio.google.com/app/apikey
# Keys must start with "AIza". Keys starting with "AQ." are OAuth tokens, not API keys.
GEMINI_API_KEY=AIzaYourGeminiApiKeyHere

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Only variables prefixed with VITE_ are available in the browser.
# This tells the frontend where the backend API is running.
VITE_API_URL=http://localhost:3001/api
